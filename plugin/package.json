{
  "name": "vault-organizer",
  "version": "0.1.0",
  "description": "Offline Obsidian plugin — FOSS embedding sorter for tags, folders, and Inbox automation",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit -p tsconfig.json && node esbuild.config.mjs production",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "pwsh -File ../scripts/deploy-to-vault.ps1"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "organizer",
    "embeddings",
    "foss"
  ],
  "devDependencies": {
    "@types/node": "^22.13.10",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.1",
    "obsidian": "^1.8.7",
    "tsx": "^4.23.7",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.4.2"
  },
  "overrides": {
    "sharp": ">=0.35.0"
  }
}
